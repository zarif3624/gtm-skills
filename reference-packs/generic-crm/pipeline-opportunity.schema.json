{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zarif3624/gtm-skills/reference-packs/generic-crm/pipeline-opportunity.schema.json",
  "title": "Generic CRM Pipeline Opportunity Snapshot",
  "description": "One immutable source record in a pipeline snapshot. Blank or unknown values must not be inferred.",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_id", "opportunity_id", "amount", "currency", "source_system", "source_updated_at"],
  "properties": {
    "record_id": {"type": "string", "minLength": 1},
    "opportunity_id": {"type": "string", "minLength": 1},
    "account_id": {"type": ["string", "null"]},
    "account_name": {"type": ["string", "null"]},
    "opportunity_name": {"type": ["string", "null"]},
    "opportunity_owner_id": {"type": ["string", "null"]},
    "stage": {"type": ["string", "null"]},
    "stage_entered_at": {"type": ["string", "null"], "format": "date-time"},
    "forecast_category": {"type": ["string", "null"]},
    "amount": {"type": "number", "minimum": 0},
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "close_date": {"type": ["string", "null"], "format": "date"},
    "created_at": {"type": ["string", "null"], "format": "date-time"},
    "last_buyer_action": {"type": ["string", "null"]},
    "last_buyer_action_at": {"type": ["string", "null"], "format": "date-time"},
    "next_step": {"type": ["string", "null"]},
    "next_step_owner_id": {"type": ["string", "null"]},
    "next_step_status": {"enum": ["Accepted", "Proposed", "Completed", "Unknown", null]},
    "next_step_due_at": {"type": ["string", "null"], "format": "date-time"},
    "required_milestone": {"type": ["string", "null"]},
    "required_milestone_status": {"enum": ["Accepted", "Proposed", "Completed", "Blocked", "Unknown", null]},
    "required_milestone_due_at": {"type": ["string", "null"], "format": "date-time"},
    "outcome": {"enum": ["Open", "Won", "Lost", "No decision", "Unknown", null]},
    "outcome_reason": {"type": ["string", "null"]},
    "outcome_evidence_status": {"enum": ["Verified", "Reported", "Inferred", "Unknown", "Contradicted", null]},
    "source_system": {"type": "string", "minLength": 1},
    "source_updated_at": {"type": "string", "format": "date-time"}
  }
}
